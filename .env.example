# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: Required for live GitHub contribution sync (GithubHeatmap).
# Generate at https://github.com/settings/tokens -> Developer settings -> Personal access tokens -> Tokens (classic)
# Scope: read:user is enough; don't grant repo. Private contributions still show up as counts when
# "Include private contributions on my profile" is on. PR/repo totals come from
# lib/github-snapshot.json (npm run github:snapshot), not from this token.
# Also set GITHUB_USERNAME to your GitHub handle.
GITHUB_TOKEN="ghp_your_token_here"
GITHUB_USERNAME="username_here"
